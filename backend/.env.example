# Reference template. Copy the values you need into your shell, IDE run
# configuration, or process manager. Spring Boot does not read .env files
# automatically, so exporting the variables is what actually applies them.
#
# Never commit the real .env.
#
# All values are optional except OPENAI_API_KEY, GITHUB_CLIENT_ID and
# GITHUB_CLIENT_SECRET, which sign-in needs. The latter two have no built-in
# default, so the service still starts without them but GitHub sign-in will
# fail until they are exported.

# --- Required ---

# OpenAI API key used for chat completions and embeddings.
OPENAI_API_KEY=

# GitHub OAuth App credentials.
# Authorization callback URL: http://localhost:8081/login/oauth2/code/github
# https://github.com/settings/developers -> OAuth Apps -> New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Optional: shown values are the built-in defaults ---

# Database (matches the postgres port published in docker-compose.yml).
DB_URL=jdbc:postgresql://localhost:5433/devpilot
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Where the browser app runs; also the default CORS origin.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Encrypts stored GitHub access tokens. The defaults below are development
# placeholders and are public - generate unique values for any real deployment.
TOKEN_ENCRYPTOR_PASSWORD=devpilot-local-encrypt-key-change-me
TOKEN_ENCRYPTOR_SALT=deadbeefcafebabe
